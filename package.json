{
  "name": "harness-align",
  "version": "1.5.0",
  "private": true,
  "description": "Desktop application to manage, generate, and deploy coding assistant configurations.",
  "author": "Harness Align",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:engine": "tsc -p tsconfig.engine.json",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.engine.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsc -p tsconfig.engine.json && node --test dist/tests/Halign.test.js",
    "verify": "tsc -p tsconfig.engine.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && node --test dist/tests/Halign.test.js",
    "lint": "eslint .",
    "preinstall": "node -e \"if (!String(process.env.npm_config_user_agent || '').startsWith('npm/')) { process.stderr.write('This project uses npm. Run npm install.\\n'); process.exit(1) }\"",
    "postinstall": "node ./node_modules/electron/install.js",
    "build:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "antd": "^6.6.1",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "smol-toml": "1.7.1",
    "yaml": "2.9.0",
    "zod": "^4.0.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "24.13.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "43.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "eslint": "^9.35.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.43.0",
    "vite": "7.3.6"
  }
}
